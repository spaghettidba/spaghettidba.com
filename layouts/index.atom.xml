{{- $posts := partial "feed-pages.html" . -}}
{{- $updated := time.AsTime "1970-01-01T00:00:00Z" -}}
{{- range $posts -}}
  {{- $entry := partial "feed-entry.html" . -}}
  {{- if gt $entry.updated $updated }}{{ $updated = $entry.updated }}{{ end -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ .Site.Language.Locale }}">
  <title>{{ .Site.Title | htmlEscape | safeHTML }}</title>
  <subtitle>{{ .Site.Params.description | htmlEscape | safeHTML }}</subtitle>
  <id>{{ "http://spaghettidba.com/feed/atom/" | htmlEscape | safeHTML }}</id>
  <link href="{{ .Site.Home.Permalink }}" rel="alternate" type="text/html"/>
  {{ with .OutputFormats.Get "Atom" }}<link href="{{ .Permalink }}" rel="self" type="application/atom+xml"/>{{ end }}
  <updated>{{ $updated.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  <author><name>{{ .Site.Params.author.name | htmlEscape | safeHTML }}</name></author>
  {{ range $posts }}
  {{ $entry := partial "feed-entry.html" . }}
  <entry>
    <title>{{ .Title | htmlEscape | safeHTML }}</title>
    <id>{{ $entry.guid | htmlEscape | safeHTML }}</id>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
    <published>{{ $entry.published.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ $entry.updated.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    <summary type="html">{{ .Summary | htmlEscape | safeHTML }}</summary>
    <content type="html">{{ $entry.content | htmlEscape | safeHTML }}</content>
  </entry>
  {{ end }}
</feed>
