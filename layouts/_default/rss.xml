{{- $pages := partial "feed-pages.html" . -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if not .IsHome }}{{ .Title | htmlEscape | safeHTML }} | {{ end }}{{ .Site.Title | htmlEscape | safeHTML }}</title>
    <link>{{ .Site.Home.Permalink | htmlEscape | safeHTML }}</link>
    <description>{{ .Site.Params.description | htmlEscape | safeHTML }}</description>
    <language>{{ .Site.Language.Locale }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
    {{ range $pages }}
      {{ $entry := partial "feed-entry.html" . }}
      <item>
        <title>{{ .Title | htmlEscape | safeHTML }}</title>
        <link>{{ .Permalink | htmlEscape | safeHTML }}</link>
        <guid isPermaLink="false">{{ $entry.guid | htmlEscape | safeHTML }}</guid>
        <pubDate>{{ $entry.published.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        <description>{{ .Summary | htmlEscape | safeHTML }}</description>
        <content:encoded>{{ $entry.content | htmlEscape | safeHTML }}</content:encoded>
      </item>
    {{ end }}
  </channel>
</rss>
